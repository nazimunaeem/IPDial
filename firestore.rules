rules_version = '2';

// Server-side security rules for the IPDial pro-points economy.
// These rules MUST be deployed to the project (firebase deploy --only firestore)
// or the client can fabricate points/expiration, bypassing the paywall.
//
// Design notes:
//  - A device may only read/write its OWN user document at /users/{deviceId}.
//  - `expiration` and `points` must NEVER be freely writable by a client. Only
//    the app's Cloud Function / server may set `expiration` (redeem) and only
//    atomic FieldValue.increment() may change `points`.
//  - Claiming a referral must be validated server-side; clients are not allowed
//    to update `referredBy` on themselves.

service cloud.firestore {
  match /databases/{database}/documents {

    // Any other collection is locked down.
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{deviceId} {
      // A device reads only its own record.
      allow get: if request.auth != null
                 && request.auth.uid == deviceId;

      // Document creation / initial registration is only allowed by the server,
      // which can mint a new doc. Clients use the server endpoint instead.
      allow create: if false;

      // Updates: only allow a bounded delta on `points` via atomic increment and
      // a server-issued timestamp. Disallow any client write to `expiration`,
      // `referredBy`, or absolute `points` values (prevents pro-for-free).
      allow update: if request.auth != null
                    && request.auth.uid == deviceId
                    && request.resource.diff(resource).affectedKeys()
                         .hasOnly(['points', 'updatedAt'])
                    && request.resource.data.points is number
                    && request.resource.data.points == resource.data.points
                    && request.resource.data.updatedAt is timestamp
                    && request.resource.data.updatedAt >= resource.data.updatedAt;

      allow delete: if false;
    }
  }
}
