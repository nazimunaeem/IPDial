<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Never upload SIP account credentials or call recordings -->
        <exclude domain="file" path="datastore/ipdial_accounts.preferences_pb" />
        <exclude domain="file" path="datastore/ipdial_accounts.preferences_pb.tmp" />
        <exclude domain="file" path="recordings/" />
    </cloud-backup>
    <device-transfer>
        <!-- Same protection for device-to-device transfers -->
        <exclude domain="file" path="datastore/ipdial_accounts.preferences_pb" />
        <exclude domain="file" path="datastore/ipdial_accounts.preferences_pb.tmp" />
        <exclude domain="file" path="recordings/" />
    </device-transfer>
</data-extraction-rules>
